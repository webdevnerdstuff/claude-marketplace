{
	"modules": ["./register.tsx"],
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/idle.sh stop",
						"asyncRewake": true,
						"timeout": 7500
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/idle.sh prompt",
						"timeout": 5
					}
				]
			}
		]
	}
}
